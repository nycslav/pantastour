{
  "name": "saraya",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap": "npm install",
    "dev:mobile": "npm run start --workspace=@saraya/mobile",
    "dev:api": "npm run dev --workspace=@saraya/api",
    "db:migrate": "npm run db:migrate --workspace=@saraya/api",
    "db:seed": "npm run db:seed --workspace=@saraya/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}

